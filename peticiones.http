# peticiones.http
# Peticiones de prueba de serviclima-api.
# Con la extensión REST Client: clic en "Send Request" encima de cada petición. 
# Este archivo crece cada sesión y es parte del entregable final.

@base = http://localhost:3001 

### Listado de órdenes
GET {{base}}/ordenes

### Detalle de una orden 
GET {{base}}/ordenes/8

### Órdenes pendientes
GET {{base}}/ordenes?estado=pendiente

### Orden que no existe (404)
GET {{base}}/ordenes/999

### Id que no es número (404) 
GET {{base}}/ordenes/abc

### Crear una orden (201, el servidor asigna id y codigo)
POST {{base}}/ordenes
Content-Type: application/json

{
    "cliente": "Ferretería El Progreso",
    "nit": "4567891-2",
    "departamento": "Chimaltenango",
    "categoria": "Instalación",
    "tecnico": "Mario Ixcot",
    "fecha": "2026-11-09",
    "horas": 4,
    "monto": 2400,
    "estado": "pendiente"
}

### Cambiar solo el estado (PATCH combina)
PATCH {{base}}/ordenes/25
Content-Type: application/json

{
    "estado": "en proceso"
}

### Reemplazar la orden completa (PUT reemplaza)
PUT {{base}}/ordenes/25
Content-Type: application/json

{
    "cliente": "Ferretería El Progreso",
    "nit": "4567891-2",
    "departamento": "Chimaltenango",
    "categoria": "Reparación",
    "tecnico": "Lucía Morales",
    "fecha": "2026-11-10",
    "horas": 5,
    "monto": 3000,
    "estado": "en proceso"
}

### Eliminar (200 con {})
DELETE {{base}}/ordenes/25

### Eliminar otra vez la misma (404)
DELETE {{base}}/ordenes/25

### Preflight del navegador (204 con los headers de CORS)
OPTIONS {{base}}/ordenes
Origin: http://localhost:5173
Access-Control-Request-Method: POST
Access-Control-Request-Headers: content-type

### La API acepta cualquier cosa (hoy responde 201)
POST {{base}}/ordenes
Content-Type: application/json

{
  "cliente": "",
  "departamento": "Marte",
  "horas": "muchas",
  "monto": -500,
  "estado": "inventado"
}


# ---------------------------------------------------------------
# Sesión 4: catálogos, validación y errores
# Todas las respuestas de error tienen la forma { "error": "...", "detalles": [...] }
# ---------------------------------------------------------------

### Catálogo de departamentos (200)
GET {{base}}/departamentos

### Catálogo de categorías (200)
GET {{base}}/categorias

### Ruta que no existe (404 desde noEncontrado)
GET {{base}}/clientes

### Crear con datos inválidos (400 con un detalle por campo)
POST {{base}}/ordenes
Content-Type: application/json

{
  "cliente": "",
  "nit": "1234567-X",
  "departamento": "Petén",
  "categoria": "Limpieza",
  "tecnico": "Mario Ixcot",
  "fecha": "11/11/2026",
  "horas": 30,
  "monto": -500,
  "estado": "inventado"
}

### Crear sin cuerpo (400: faltan todos los campos)
POST {{base}}/ordenes

### Números enviados como texto (400 en horas y monto)
POST {{base}}/ordenes
Content-Type: application/json

{
  "cliente": "Ferretería El Progreso",
  "nit": "4567891-2",
  "departamento": "Chimaltenango",
  "categoria": "Instalación",
  "tecnico": "Mario Ixcot",
  "fecha": "2026-11-11",
  "horas": "4",
  "monto": "2400",
  "estado": "pendiente"
}

### Campos extra: se ignoran (201; id y codigo los pone el servidor, sin "descuento")
POST {{base}}/ordenes
Content-Type: application/json

{
  "id": 999,
  "codigo": "OS-2026-999",
  "cliente": "Consumidor Final",
  "nit": "CF",
  "departamento": "Guatemala",
  "categoria": "Diagnóstico",
  "tecnico": "Ana Chacón",
  "fecha": "2026-11-11",
  "horas": 1.5,
  "monto": 450,
  "descuento": 100,
  "estado": "pendiente"
}

### PATCH con un estado que no existe (400)
PATCH {{base}}/ordenes/1
Content-Type: application/json

{
  "estado": "terminada"
}

### PATCH con solo codigo, como el que hace el frontend al crear (200 sin cambios)
PATCH {{base}}/ordenes/1
Content-Type: application/json

{
  "codigo": "OS-2026-001"
}

### PUT incompleto (400: PUT exige la orden completa)
PUT {{base}}/ordenes/1
Content-Type: application/json

{
  "estado": "completada"
}

### PATCH a una orden que no existe (404 desde el controlador)
PATCH {{base}}/ordenes/999
Content-Type: application/json

{
  "estado": "cancelada"
}

### JSON mal escrito: falta la comilla de cierre (400)
POST {{base}}/ordenes
Content-Type: application/json

{
  "cliente": "Ferretería El Progreso
}


# ------------------------------------------------------------
# Sesión 5: SQLite, filtros y resumen
# ------------------------------------------------------------

### Persistencia: cree esta orden, reinicie el servidor y vuelva a pedir el listado
POST {{base}}/ordenes
Content-Type: application/json

{
  "cliente": "Panadería San Martín",
  "nit": "8899001-K",
  "departamento": "Sacatepéquez",
  "categoria": "Reparación",
  "tecnico": "Byron Tzul",
  "fecha": "2026-11-16",
  "horas": 2.5,
  "monto": 900,
  "estado": "pendiente"
}

### Filtro por estado
GET {{base}}/ordenes?estado=pendiente

### Filtro por técnico (el espacio se escribe %20)
GET {{base}}/ordenes?tecnico=Mario%20Ixcot

### Filtro por departamento
GET {{base}}/ordenes?departamento=Guatemala

### Dos filtros a la vez (AND)
GET {{base}}/ordenes?estado=completada&tecnico=Ana%20Chac%C3%B3n

### Filtro sin coincidencias (200 con [])
GET {{base}}/ordenes?estado=archivada

### Filtro desconocido: se ignora (200 con todas)
GET {{base}}/ordenes?color=rojo

### Intento de inyección en un filtro (200 con []: el valor viaja en ?)
GET {{base}}/ordenes?estado=x'%20OR%20'1'='1

### Resumen: totales por estado y por técnico
GET {{base}}/resumen
